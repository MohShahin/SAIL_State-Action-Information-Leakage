{
  "version": "0.2.0",
  "configurations": [
    {
      // F5. Opens the test window itself (see the "debuggable" task) with the extension host's debug port
      // on 127.0.0.1, then attaches to exactly that address. VS Code's own "extensionHost" launcher picks
      // "localhost" instead, which resolves to IPv6 (::1) on some machines where the port is not listening,
      // so it can never attach and reports "Extension host did not start in 10 seconds".
      "name": "Debug SAIL",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 5870,
      "timeout": 60000,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "SAIL: open test window (debuggable)"
    },
    {
      // VS Code's built-in launcher. Fine on most machines; see the note above if it hangs.
      "name": "Run SAIL (VS Code's launcher)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "--disable-extensions"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: bundle"
    }
  ]
}
