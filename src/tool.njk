layout: section.njk
title: "Tool"
activeNav: tool
secId: tool
permalink: /tool/
---

{% set sec = sections | findSection(secId) %}
<h2 data-t="Run the five checks.">Run the five checks.</h2>
<p class="plain" style="max-width:62ch;" data-t="This is a working preview on synthetic data. Change how the dataset is built and watch which checks fire. The real package does this on your own files.">This is a working preview on synthetic data. Change how the dataset is built and watch which checks fire. The real package does this on your own files.</p>
<style>
.simwrap{display:grid;grid-template-columns:minmax(0,340px) minmax(0,1fr);gap:24px;margin:24px 0 40px;align-items:start}
@media (max-width:820px){.simwrap{grid-template-columns:minmax(0,1fr)}}
.simwrap .card{padding:18px}
.tog{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.tog small{display:block;color:var(--ink-faint);font-size:12.5px}
.sw{appearance:none;-webkit-appearance:none;width:44px;height:26px;border-radius:99px;background:#cbd5e1;position:relative;flex:none;cursor:pointer;transition:.2s}
.sw::after{content:"";position:absolute;top:3px;inset-inline-start:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:.2s}
.sw:checked{background:var(--accent)}.sw:checked::after{inset-inline-start:21px}
.sw:focus-visible,.simwrap button:focus-visible,.simwrap input[type=range]:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.simwrap input[type=range]{width:100%;accent-color:var(--accent)}
.simbtns{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.simbtns button{border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:8px 12px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}
.simbtns button:hover{border-color:var(--accent)}
.det{display:flex;padding:14px 16px;border:1px solid var(--line);border-radius:10px;background:var(--paper);border-inline-start-width:6px;margin-bottom:12px}
.det.flag{border-inline-start-color:#d97706}.det.pass{border-inline-start-color:#16a34a}.det.skip{border-inline-start-color:#94a3b8}
.det h3{margin:0 0 3px;font-size:16px}.det p{margin:0;font-size:14.5px;color:var(--ink-soft)}
.det .top{display:flex;justify-content:space-between;gap:10px;align-items:center}
.det .fix{margin-top:8px;font-size:14px;background:#f1f5f9;border-radius:8px;padding:8px 10px;color:var(--ink)}
.badge{font-size:11px;font-weight:700;letter-spacing:.06em;padding:2px 9px;border-radius:99px;border:1px solid currentColor;white-space:nowrap}
.badge.flag{color:#b45309}.badge.pass{color:#15803d}.badge.skip{color:#64748b}
:lang(ar) .badge,:lang(hi) .badge{letter-spacing:0}
.simsum h3{font-size:26px;margin:0}.simsum p{margin:2px 0 14px;color:var(--ink-soft)}
.demo-pill{font-size:12px;border:1px solid var(--accent);color:var(--accent);border-radius:99px;padding:2px 10px;white-space:nowrap}
</style>
<div class="simwrap">
 <div class="card">
  <h3 data-t="Dataset recipe">Dataset recipe</h3>
  <div class="tog"><div><span data-t="Include cardiovascular SOFA">Include cardiovascular SOFA</span><small data-t="Score depends on whether a vasopressor runs">Score depends on whether a vasopressor runs</small></div><input class="sw" type="checkbox" id="t_sofa" checked aria-label="Include cardiovascular SOFA"></div>
  <div class="tog"><div><span data-t="Include previous action">Include previous action</span><small data-t="Last hour's drug and fluid doses">Last hour's drug and fluid doses</small></div><input class="sw" type="checkbox" id="t_prev" checked aria-label="Include previous action"></div>
  <div class="tog"><div><span data-t="Rebuild features from derived columns">Rebuild features from derived columns</span><small data-t="Removed feature is recoverable">Removed feature is recoverable</small></div><input class="sw" type="checkbox" id="t_rec" aria-label="Rebuild features from derived columns"></div>
  <div class="tog"><div><span data-t="Declare time columns">Declare time columns</span><small data-t="Needed by the timing checks">Needed by the timing checks</small></div><input class="sw" type="checkbox" id="t_time" checked aria-label="Declare time columns"></div>
  <div style="padding-top:14px"><label for="t_win" style="font-size:14px;font-weight:600"><span data-t="State window ends">State window ends</span> <b id="t_winv">0</b> <span data-t="h before the decision">h before the decision</span></label><input type="range" id="t_win" min="-2" max="4" value="0"></div>
  <div class="simbtns"><button type="button" id="t_good" data-t="Load a clean recipe">Load a clean recipe</button><button type="button" id="t_bad" data-t="Load a leaky recipe">Load a leaky recipe</button></div>
 </div>
 <div>
  <div class="top" style="display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:12px"><div id="t_sum" class="simsum" aria-live="polite"></div><span class="demo-pill" data-t="Synthetic demo data">Synthetic demo data</span></div>
  <div id="t_out"></div>
 </div>
</div>
<script>
(function(){
var $=function(s){return document.getElementById(s)};
function T(s){var k=document.documentElement.lang;return (k!=='en'&&window.SAIL_STR&&SAIL_STR[s]&&SAIL_STR[s][k])||s}
function esc(s){return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function run(){var s=$('t_sofa').checked,p=$('t_prev').checked,r=$('t_rec').checked,t=$('t_time').checked,w=+$('t_win').value;$('t_winv').textContent=w;
 var D=[];
 D.push({n:'Construction',q:'Is a feature’s value set by treatment instead of physiology?',st:s?'flag':'pass',m:s?'Cardiovascular SOFA is constant in blood pressure once a vasopressor runs, so it carries the drug.':'No feature whose value is set by the treatment was found.',f:s?'Replace the score with its physiological inputs (MAP, drug flag) or drop it.':''});
 D.push({n:'Reconstruction',q:'Can a removed feature be rebuilt from what is left?',st:r?'flag':'pass',m:r?'The removed score can be rebuilt from the remaining columns, so removing it did nothing.':'The remaining columns cannot rebuild the removed feature.',f:r?'Remove the derived columns that contain total SOFA as well.':''});
 if(!t){D.push({n:'Temporal overlap',q:'Does the state window already contain the treatment?',st:'skip',m:'Not run. The state and action time columns are not declared.',f:'Add the two time columns in the column step.'});D.push({n:'Timing violation',q:'Does an action window start before its state window ends?',st:'skip',m:'Not run. The same two columns are missing.',f:'Declare them to run this check.'})}
 else{D.push({n:'Temporal overlap',q:'Does the state window already contain the treatment?',st:w<0?'flag':'pass',m:w<0?'The state window reaches {n} h past the start of treatment.':'The state window ends before treatment starts.',f:w<0?'End the state window at the decision time.':'',sub:-w});
 D.push({n:'Timing violation',q:'Does an action window start before its state window ends?',st:w<0?'flag':'pass',m:w<0?'Action window begins before the state window ends.':'Windows are ordered correctly.',f:w<0?'Shift the action window to start at or after the state window end.':''})}
 D.push({n:'Persistence dominance',q:'Does the previous action alone match your full state?',st:p?'flag':'pass',m:p?'On the real cohort (13,192 stays) the previous action alone reaches AUROC 0.910.':'No dominant previous-action feature.',f:p?'Report results with and without the previous action, and by whether a drug was already running.':''});
 var fl=D.filter(function(d){return d.st==='flag'}).length,sk=D.filter(function(d){return d.st==='skip'}).length,ps=D.length-fl-sk;
 $('t_sum').innerHTML='<h3>'+fl+' '+esc(T('flagged'))+' · '+ps+' '+esc(T('passed'))+(sk?' · '+sk+' '+esc(T('not run')):'')+'</h3><p>'+esc(T(fl?'Your validation numbers may overstate real performance.':'No shortcut found by these checks.'))+'</p>';
 var lab={flag:'FLAGGED',pass:'PASSED',skip:'NOT RUN'};
 $('t_out').innerHTML=D.map(function(d){var m=T(d.m);if(d.sub!==undefined)m=m.replace('{n}',d.sub);
  return '<div class="det '+d.st+'"><div style="flex:1;min-width:0"><div class="top"><h3>'+esc(T(d.n))+'</h3><span class="badge '+d.st+'">'+esc(T(lab[d.st]))+'</span></div><p>'+esc(T(d.q))+'</p><p style="color:var(--ink);margin-top:6px">'+esc(m)+'</p>'+(d.f?'<div class="fix"><b>'+esc(T('Fix:'))+'</b> '+esc(T(d.f))+'</div>':'')+'</div></div>'}).join('')}
['t_sofa','t_prev','t_rec','t_time','t_win'].forEach(function(i){$(i).addEventListener('input',run);$(i).addEventListener('change',run)});
$('t_good').onclick=function(){$('t_sofa').checked=false;$('t_prev').checked=false;$('t_rec').checked=false;$('t_time').checked=true;$('t_win').value=0;run()};
$('t_bad').onclick=function(){$('t_sofa').checked=true;$('t_prev').checked=true;$('t_rec').checked=true;$('t_time').checked=true;$('t_win').value=-2;run()};
window.SAIL_ONLANG=run;run();
})();
</script>
<div class="grid-12" style="margin-top:8px">
  <div class="col-span-4"><div class="card" style="height:100%;"><h3 data-t="VS Code extension">VS Code extension</h3><p class="plain" data-t="Choose data, confirm columns, read a plain-language report with a fix for every flag.">Choose data, confirm columns, read a plain-language report with a fix for every flag.</p></div></div>
  <div class="col-span-4"><div class="card" style="height:100%;"><h3 data-t="Python package">Python package</h3><p class="plain" data-t="One command in CI. The report is a file you can attach to a submission.">One command in CI. The report is a file you can attach to a submission.</p><pre><code>pip install sail-leakage</code></pre></div></div>
  <div class="col-span-4"><div class="card" style="height:100%;"><h3 data-t="Reports you can cite">Reports you can cite</h3><p class="plain" data-t="Each check has a stable ID and a plain-language explanation so a reviewer can follow it.">Each check has a stable ID and a plain-language explanation so a reviewer can follow it.</p></div></div>
</div>
<div class="grid-12" style="margin-top:24px">{% for l in sec.links %}
  <div class="col-span-6"><div class="card" style="height:100%;"><a href="{{ l[1] | withPrefix }}" style="color:var(--accent);font-weight:600;"><span data-t="{{ l[0] }}">{{ l[0] }}</span> <span class="arr" aria-hidden="true">→</span></a></div></div>{% endfor %}
</div>
