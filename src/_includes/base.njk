<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — SAIL</title>
<link rel="icon" type="image/png" href="__PATHPREFIX__/assets/img/favicon.png">
<link rel="icon" type="image/x-icon" href="__PATHPREFIX__/assets/img/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="__PATHPREFIX__/assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="__PATHPREFIX__/assets/style.css">
{%- if needsMathJax %}
<script>window.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js" async></script>
{%- endif %}
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
</head>
<body>

<nav class="sitenav"><div class="sitenav-inner">
  <a class="sitenav-brand" href="__PATHPREFIX__/">
    <img src="__PATHPREFIX__/assets/img/logo-cropped.png" alt="SAIL logo">
    <span>SAIL</span>
  </a>
  <div class="sitenav-links">
    {%- for s in sections %}
    <a href="{{ s.path | withPrefix }}" data-nav="{{ s.i }}"{% if activeNav == s.id %} class="active"{% endif %}>{{ i18n.en.nav[s.i] }}</a>
    {%- endfor %}
    <select id="langSel" aria-label="Language" style="margin-left:8px;">{% for k, l in i18n %}<option value="{{ k }}">{{ l.name }}</option>{% endfor %}</select>
  </div>
  <script>window.SAIL_I18N = {{ i18n | dump | safe }};</script>
  <script>
  (function(){var L=window.SAIL_I18N,s=document.getElementById('langSel');if(!s)return;
   function g(){try{return localStorage.getItem('sail-lang')}catch(e){return null}}
   function apply(k){if(!L[k])k='en';document.documentElement.lang=k;document.documentElement.dir=L[k].dir;s.value=k;
    document.querySelectorAll('[data-nav]').forEach(function(a){a.textContent=L[k].nav[a.dataset.nav]});
    document.querySelectorAll('[data-i18n-nav]').forEach(function(h){h.textContent=L[k].nav[h.dataset.i18nNav]})}
   s.onchange=function(){try{localStorage.setItem('sail-lang',s.value)}catch(e){}apply(s.value)};apply(g()||'en');})();
  </script>
</div></nav>

{{ content | safe }}

<footer class="page-footer">
  <p><a href="__PATHPREFIX__/about/">About</a> · <a href="__PATHPREFIX__/datasets-and-models/">Datasets &amp; models</a> · <a href="__PATHPREFIX__/papers/">Papers</a> · <a href="__PATHPREFIX__/privacy/">Privacy</a> · <a href="__PATHPREFIX__/detectors/">Detectors</a></p>
  MIT Laboratory for Computational Physiology × Boston University School of Public Health
</footer>

</body>
</html>
