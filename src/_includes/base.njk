<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — SAIL</title>
<link rel="icon" type="image/png" href="__PATHPREFIX__/assets/img/favicon.png">
<link rel="icon" type="image/x-icon" href="__PATHPREFIX__/assets/img/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="__PATHPREFIX__/assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="__PATHPREFIX__/assets/style.css">
{%- if needsMathJax %}
<script>window.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js" async></script>
{%- endif %}
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
</head>
<body>

<nav class="sitenav"><div class="sitenav-inner">
  <a class="sitenav-brand" href="__PATHPREFIX__/">SAIL</a>
  <div class="sitenav-links">
    <a href="__PATHPREFIX__/"{% if activeNav == "home" %} class="active"{% endif %}>Home</a>
    <a href="__PATHPREFIX__/mechanisms/"{% if activeNav == "mechanisms" %} class="active"{% endif %}>Mechanisms</a>
    <a href="__PATHPREFIX__/demo/"{% if activeNav == "demo" %} class="active"{% endif %}>Walkthrough</a>
    <a href="__PATHPREFIX__/visualizer/"{% if activeNav == "visualizer" %} class="active"{% endif %}>Demo</a>
    <a href="__PATHPREFIX__/evidence/"{% if activeNav == "evidence" %} class="active"{% endif %}>Evidence</a>
    <a href="__PATHPREFIX__/proof/"{% if activeNav == "proof" %} class="active"{% endif %}>Proof</a>
    <a href="__PATHPREFIX__/reproducibility/"{% if activeNav == "reproducibility" %} class="active"{% endif %}>Reproducibility</a>
    <a href="__PATHPREFIX__/papers/"{% if activeNav == "papers" %} class="active"{% endif %}>Papers</a>
    <a href="__PATHPREFIX__/about/"{% if activeNav == "about" %} class="active"{% endif %}>About</a>
    <a href="__PATHPREFIX__/status/"{% if activeNav == "status" %} class="active"{% endif %}>Status</a>
  </div>
</div></nav>

{{ content | safe }}

<footer class="page-footer">
  MIT Laboratory for Computational Physiology × Boston University School of Public Health
</footer>

</body>
</html>
