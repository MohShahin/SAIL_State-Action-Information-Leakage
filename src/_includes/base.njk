<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — SAIL</title>
<link rel="icon" type="image/png" href="__PATHPREFIX__/assets/img/favicon.png">
<link rel="icon" type="image/x-icon" href="__PATHPREFIX__/assets/img/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="__PATHPREFIX__/assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="__PATHPREFIX__/assets/style.css">
<script>(function(){try{var k=localStorage.getItem('sail-lang');var rtl={ar:1};if(k&&/^(en|ar|es|fr|pt|hi|zh)$/.test(k)){var h=document.documentElement;h.lang=k;h.dir=rtl[k]?'rtl':'ltr';var f={ar:'Noto+Sans+Arabic',hi:'Noto+Sans+Devanagari',zh:'Noto+Sans+SC'}[k];if(f){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family='+f+':wght@400;600;700&display=swap';document.head.appendChild(l);}}}catch(e){}})();</script>
{%- if needsMathJax %}
<script>window.MathJax = { tex: { inlineMath: [['$','$']], displayMath: [['$$','$$']] } };</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/3.2.2/es5/tex-mml-chtml.min.js" async></script>
{%- endif %}
{%- if extraHead %}
{{ extraHead | safe }}
{%- endif %}
<style>
#pal{position:fixed;inset:0;background:rgba(15,23,42,.55);display:none;align-items:flex-start;justify-content:center;padding:12vh 16px 0;z-index:100}
#pal.on{display:flex}
#pal .box{background:var(--paper,#fff);color:var(--ink,#0f172a);border:1px solid var(--line,#e2e8f0);border-radius:12px;width:min(560px,100%);box-shadow:0 20px 60px rgba(0,0,0,.35);overflow:hidden}
#pal input{width:100%;border:0;border-bottom:1px solid var(--line,#e2e8f0);padding:14px 16px;font:inherit;font-size:16px;background:transparent;color:inherit;outline:none}
#pal ul{list-style:none;margin:0;padding:6px;max-height:50vh;overflow:auto}
#pal li a{display:flex;justify-content:space-between;gap:12px;padding:9px 10px;border-radius:8px;text-decoration:none;color:inherit}
#pal li a.sel,#pal li a:hover{background:rgba(8,145,178,.14)}
#pal li small{opacity:.65;white-space:nowrap}
#palBtn{margin-inline-start:8px;background:transparent;border:1px solid #3b4654;color:#cbd5e1;border-radius:8px;padding:5px 10px;font:inherit;font-size:13px;cursor:pointer}
</style>
</head>
<body>

<nav class="sitenav"><div class="sitenav-inner">
  <a class="sitenav-brand" href="__PATHPREFIX__/">
    <img src="__PATHPREFIX__/assets/img/logo-cropped.png" alt="SAIL logo">
    <span>SAIL</span>
  </a>
  <div class="sitenav-links">
    {%- for s in sections %}
    <a href="{{ s.path | withPrefix }}" data-nav="{{ s.i }}"{% if activeNav == s.id %} class="active"{% endif %}>{{ i18n.en.nav[s.i] }}</a>
    {%- endfor %}
    <button type="button" id="palBtn" aria-label="Search" data-t="Search">Search</button><select id="langSel" aria-label="Language">{% for k, l in i18n %}<option value="{{ k }}">{{ l.name }}</option>{% endfor %}</select>
  </div>

</div></nav>

<div id="sailPage">
{{ content | safe }}
</div>

<footer class="page-footer">
  <p><a href="__PATHPREFIX__/about/" data-t="About">About</a> · <a href="__PATHPREFIX__/datasets-and-models/" data-t="Datasets &amp; models">Datasets &amp; models</a> · <a href="__PATHPREFIX__/papers/" data-t="Papers">Papers</a> · <a href="__PATHPREFIX__/privacy/" data-t="Privacy">Privacy</a> · <a href="__PATHPREFIX__/detectors/" data-t="Detectors">Detectors</a></p>
  <span data-t="MIT Laboratory for Computational Physiology × Boston University School of Public Health">MIT Laboratory for Computational Physiology × Boston University School of Public Health</span>
</footer>

<script src="__PATHPREFIX__/assets/i18n.js"></script>
  <script>
  (function(){var L=window.SAIL_I18N,S=window.SAIL_STR,sel=document.getElementById('langSel');if(!sel)return;
   var page=document.getElementById('sailPage');
   var FONT={ar:'Noto+Sans+Arabic',hi:'Noto+Sans+Devanagari',zh:'Noto+Sans+SC'};
   function stored(){try{return localStorage.getItem('sail-lang')}catch(e){return null}}
   function font(k){if(!FONT[k]||document.querySelector('link[data-f="'+k+'"]'))return;var l=document.createElement('link');l.rel='stylesheet';l.dataset.f=k;l.href='https://fonts.googleapis.com/css2?family='+FONT[k]+':wght@400;600;700&display=swap';document.head.appendChild(l)}
   function render(k){var h=document.documentElement;h.lang=k;h.dir=L[k].dir;sel.value=k;font(k);
    document.querySelectorAll('[data-nav]').forEach(function(a){a.textContent=L[k].nav[a.dataset.nav]});
    document.querySelectorAll('[data-i18n-nav]').forEach(function(e){e.textContent=L[k].nav[e.dataset.i18nNav]});
    document.querySelectorAll('[data-t]').forEach(function(e){var en=e.dataset.t,tr=(k!=='en'&&S[en])?S[en][k]:null;e.textContent=tr||en});if(window.SAIL_ONLANG)window.SAIL_ONLANG(k)}
   function apply(k,animate){if(!L[k])k='en';
    if(!animate||!page){render(k);return}
    page.classList.add('swap');setTimeout(function(){render(k);page.classList.remove('swap')},160)}
   sel.onchange=function(){try{localStorage.setItem('sail-lang',sel.value)}catch(e){}apply(sel.value,true)};
   apply(stored()||'en',false);})();
  </script>


<div id="pal" role="dialog" aria-modal="true" aria-label="Search"><div class="box"><input id="palQ" autocomplete="off" aria-label="Search"><ul id="palL"></ul></div></div>
<script>
(function(){var pal=document.getElementById('pal'),q=document.getElementById('palQ'),ul=document.getElementById('palL'),idx=null,sel=0,cur=[];
function T(s){var k=document.documentElement.lang;return (k!=='en'&&window.SAIL_STR&&SAIL_STR[s]&&SAIL_STR[s][k])||s}
function label(it){if(it.n!==undefined)return window.SAIL_I18N[document.documentElement.lang].nav[it.n];
 var m=/^Episode (\d) · (.*)$/.exec(it.t);if(m)return T('Episode '+m[1])+' · '+T(m[2]);return T(it.t)}
function grp(it){if(!it.g||it.n!==undefined)return '';var i=SAIL_I18N.en.nav.indexOf(it.g);return i>=0?SAIL_I18N[document.documentElement.lang].nav[i]:T(it.g)}
function href(u){return '__PATHPREFIX__'+u}
function draw(){var s=q.value.trim().toLowerCase();cur=(idx||[]).map(function(it){return {it:it,l:label(it)}}).filter(function(x){return !s||x.l.toLowerCase().indexOf(s)>=0||x.it.t.toLowerCase().indexOf(s)>=0}).slice(0,12);
 if(sel>=cur.length)sel=0;ul.innerHTML='';cur.forEach(function(x,i){var li=document.createElement('li'),a=document.createElement('a');a.href=href(x.it.u);if(i===sel)a.className='sel';var s1=document.createElement('span');s1.textContent=x.l;var s2=document.createElement('small');s2.textContent=grp(x.it);a.append(s1,s2);li.append(a);ul.append(li)})}
function open(){pal.classList.add('on');q.placeholder=T('Search');q.value='';sel=0;if(!idx){fetch('__PATHPREFIX__/assets/search.json').then(function(r){return r.json()}).then(function(j){idx=j;draw()}).catch(function(){})}draw();q.focus()}
function close(){pal.classList.remove('on')}
document.getElementById('palBtn').onclick=open;
document.addEventListener('keydown',function(e){var on=pal.classList.contains('on');
 if((e.key==='k'||e.key==='K')&&(e.metaKey||e.ctrlKey)){e.preventDefault();on?close():open();return}
 if(!on)return;if(e.key==='Escape'){close()}
 else if(e.key==='ArrowDown'){e.preventDefault();sel=Math.min(sel+1,cur.length-1);draw()}
 else if(e.key==='ArrowUp'){e.preventDefault();sel=Math.max(sel-1,0);draw()}
 else if(e.key==='Enter'&&cur[sel]){location.href=href(cur[sel].it.u)}});
pal.addEventListener('mousedown',function(e){if(e.target===pal)close()});q.addEventListener('input',function(){sel=0;draw()});
})();
</script>
</body>
</html>
