---
layout: section.njk
title: "Community"
activeNav: community
secId: community
permalink: /community/
---
{% set sec = sections | findSection(secId) %}
<style>
.chap{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin:20px 0 12px}
.chapc{border:1px solid var(--line);border-radius:16px;padding:20px;background:var(--card);transition:border-color .2s}
.chapc.sel{border-color:var(--link);box-shadow:0 0 0 1px var(--link) inset}
.chapc h3{margin:0 0 2px;font-size:20px;border:0;padding:0;text-transform:none;letter-spacing:0;color:var(--ink)}
.chapc .co{color:var(--ink-soft);font-size:14px;margin:0 0 10px}
.chapc .st{display:inline-block;font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;border-radius:99px;padding:2px 10px;border:1px solid currentColor}
.chapc .st.f{color:var(--physio)}.chapc .st.p{color:var(--gold)}
:lang(ar) .chapc .st,:lang(hi) .chapc .st{letter-spacing:0;text-transform:none}
.chapc ul{margin:12px 0 0;padding-inline-start:18px;font-size:14.5px}
.chapc dl{display:grid;grid-template-columns:max-content 1fr;gap:3px 12px;margin:12px 0;font-size:14px}
.chapc dt{color:var(--ink-soft);font-weight:600}.chapc dd{margin:0}
.tbd{display:inline-block;border:1px dashed var(--line-strong);border-radius:6px;padding:0 8px;color:var(--ink-soft)}
.showmap{background:transparent;border:1px solid var(--line);border-radius:10px;color:var(--ink);padding:8px 14px;font:inherit;font-size:14px;font-weight:600;cursor:pointer}
.showmap:hover{border-color:var(--link)}
.mapcard{padding:14px;margin:8px 0 8px}
.maptools{display:flex;gap:8px;flex-wrap:wrap;margin:2px 0 10px}
.mv{background:var(--wash);border:1px solid var(--line);border-radius:99px;padding:6px 14px;font:inherit;font-size:14px;font-weight:600;color:var(--ink-soft);cursor:pointer}
.mv.on{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.wmap{width:100%;height:auto;display:block;border-radius:12px;background:var(--wash)}
.wmap .sph{fill:var(--wash);stroke:none}
.wmap .land{fill:var(--line-soft);stroke:none}
.wmap .bord{fill:none;stroke:var(--line);stroke-width:.5;vector-effect:non-scaling-stroke}
.wmap .pin{cursor:pointer;outline:none}
.wmap .pin .dot{fill:var(--link);stroke:var(--bg);stroke-width:1.5;vector-effect:non-scaling-stroke}
.wmap .pin.p .dot{fill:var(--gold)}
.wmap .pin .halo{fill:var(--link);opacity:.25}
.wmap .pin.p .halo{fill:var(--gold)}
.wmap .pin .lbl{fill:var(--ink);font-weight:700;font-family:var(--sans);paint-order:stroke;stroke:var(--wash);stroke-width:3px;stroke-linejoin:round}
.wmap .pin:hover .halo,.wmap .pin:focus-visible .halo,.wmap .pin.sel .halo{opacity:.55}
.wmap .pin:focus-visible .dot{stroke:var(--ink);stroke-width:2.5}
@keyframes pulse{0%{opacity:.5}100%{opacity:.15}}
.wmap .pin.sel .halo{animation:pulse 1.6s ease-in-out infinite alternate}
.mapinfo{margin:10px 4px 2px;color:var(--ink-soft);min-height:1.6em}
.mapinfo b{color:var(--ink)}
@media(prefers-reduced-motion:reduce){.wmap .pin.sel .halo{animation:none}}
</style>
<h2 data-t="Chapters">Chapters</h2>
<p class="plain" style="max-width:68ch" data-t="{{ chapters.note }}">{{ chapters.note }}</p>
<div class="chap">{% for c in chapters.items %}<article class="chapc" data-city="{{ c.city }}"><h3>{{ c.city }}</h3><p class="co">{{ c.country }}</p>
<span class="st {{ 'f' if c.status == 'Founding chapter' else 'p' }}" data-t="{{ c.status }}">{{ c.status }}</span>
<ul>{% for i in c.institutions %}<li>{{ i }}</li>{% endfor %}</ul>
<dl><dt data-t="Chapter lead">Chapter lead</dt><dd><span class="tbd" data-t="To be confirmed">To be confirmed</span></dd><dt data-t="Next meeting">Next meeting</dt><dd><span class="tbd" data-t="Date to be announced">Date to be announced</span></dd></dl><button type="button" class="showmap" data-city="{{ c.city }}" data-t="Show on map">Show on map</button></article>{% endfor %}</div>
<div class="mapcard card">
<div class="maptools" role="group" aria-label="Map view">
 <button type="button" class="mv on" data-view="world" data-t="World">World</button>
 <button type="button" class="mv" data-view="Boston" data-t="Boston">Boston</button>
 <button type="button" class="mv" data-view="levant" data-t="Beirut and Amman">Beirut and Amman</button>
</div>
<svg id="wmap" class="wmap" viewBox="0 0 {{ worldmap.w }} {{ worldmap.h }}" role="group" aria-labelledby="wmT wmD">
<title id="wmT">Chapter map</title><desc id="wmD">Interactive world map with three chapter cities: Boston, Beirut and Amman. Use the buttons to zoom, or select a city.</desc>
<path class="sph" d="{{ worldmap.grat }}"/>
<path class="land" d="{{ worldmap.land }}"/>
<path class="bord" d="{{ worldmap.borders }}"/>
<g id="pins">{% for c in chapters.items %}{% set pt = worldmap.pins[c.city] %}<g class="pin {{ 'f' if c.status == 'Founding chapter' else 'p' }}" tabindex="0" role="button" data-city="{{ c.city }}" data-x="{{ pt[0] }}" data-y="{{ pt[1] }}" aria-label="{{ c.city }}, {{ c.country }}: {{ c.status }}"><circle class="halo" cx="{{ pt[0] }}" cy="{{ pt[1] }}" r="10"/><circle class="dot" cx="{{ pt[0] }}" cy="{{ pt[1] }}" r="5"/><text x="{{ pt[0] }}" y="{{ pt[1] }}" class="lbl">{{ c.city }}</text></g>{% endfor %}</g>
</svg>
<p class="mapinfo" id="mapInfo" aria-live="polite" data-t="Select a city on the map, or a chapter below.">Select a city on the map, or a chapter below.</p>
</div>
<p class="plain" style="font-size:14px"><a href="__PATHPREFIX__/workshops/" style="color:var(--accent);font-weight:600"><span data-t="Find a time that works across chapters">Find a time that works across chapters</span> <span class="arr" aria-hidden="true">→</span></a></p>

<h2 style="margin-top:36px" data-t="Get involved">Get involved</h2>
<div class="grid-12">{% for l in sec.links %}
  <div class="col-span-6"><div class="card" style="height:100%;"><a href="{{ l[1] | withPrefix }}" style="color:var(--accent);font-weight:600;"><span data-t="{{ l[0] }}">{{ l[0] }}</span> <span class="arr" aria-hidden="true">→</span></a></div></div>{% endfor %}
</div>
<p class="plain" style="margin-top:24px;" data-t="No patient-level data goes into this repository, ever. Maintainers will be named after the launch meeting.">No patient-level data goes into this repository, ever. Maintainers will be named after the launch meeting.</p>

<script>
(function(){
var svg=document.getElementById('wmap');if(!svg)return;
var W=+svg.viewBox.baseVal.width,H=+svg.viewBox.baseVal.height;
var views={world:[0,0,W,H],Boston:[236,92,176,91.5],levant:[566,142,52,27]};
var cur=views.world.slice(),raf=0,reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function T(k){var S=window.SAIL_STR&&window.SAIL_STR[k],l=document.documentElement.lang;return(S&&S[l])||k}
function apply(v){svg.setAttribute('viewBox',v.join(' '));var sc=v[2]/svg.clientWidth;
 [].forEach.call(svg.querySelectorAll('.pin'),function(p){var x=+p.dataset.x,y=+p.dataset.y,d=p.querySelector('.dot'),h=p.querySelector('.halo'),t=p.querySelector('.lbl');
  d.setAttribute('r',5*sc);h.setAttribute('r',11*sc);t.setAttribute('font-size',13*sc);var dy=p.dataset.city==='Amman'?20*sc:(p.dataset.city==='Beirut'?-6*sc:4.5*sc);t.setAttribute('x',x+10*sc);t.setAttribute('y',y+dy);t.style.strokeWidth=(3*sc)+'px'})}
function go(name){var to=views[name];if(!to)return;[].forEach.call(document.querySelectorAll('.mv'),function(b){b.classList.toggle('on',b.dataset.view===name)});
 cancelAnimationFrame(raf);var from=cur.slice(),t0=null;
 if(reduce){cur=to.slice();apply(cur);return}
 (function step(t){if(!t0)t0=t;var k=Math.min(1,(t-t0)/450),e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2;cur=from.map(function(a,i){return a+(to[i]-a)*e});apply(cur);if(k<1)raf=requestAnimationFrame(step)})(performance.now())}
function select(city,zoom){[].forEach.call(document.querySelectorAll('.pin,.chapc'),function(e){e.classList.toggle('sel',e.dataset.city===city)});
 var c=document.querySelector('.chapc[data-city="'+city+'"]');var info=document.getElementById('mapInfo');
 if(c){info.removeAttribute('data-t');info.innerHTML='<b></b> · <span></span> · <span></span>';info.children[0].textContent=c.querySelector('h3').textContent+', '+c.querySelector('.co').textContent;info.children[1].textContent=c.querySelector('.st').textContent;info.children[2].textContent=[].map.call(c.querySelectorAll('li'),function(l){return l.textContent}).join(' + ')}
 if(zoom)go(city==='Boston'?'Boston':'levant')}
[].forEach.call(document.querySelectorAll('.mv'),function(b){b.addEventListener('click',function(){go(b.dataset.view)})});
[].forEach.call(svg.querySelectorAll('.pin'),function(p){p.addEventListener('click',function(){select(p.dataset.city,true)});p.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();select(p.dataset.city,true)}})});
[].forEach.call(document.querySelectorAll('.showmap'),function(b){b.addEventListener('click',function(){select(b.dataset.city,true);svg.scrollIntoView({behavior:reduce?'auto':'smooth',block:'center'})})});
window.addEventListener('resize',function(){apply(cur)});apply(cur);
})();
</script>
