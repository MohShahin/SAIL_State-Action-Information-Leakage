<p class="plain"><strong data-t="{{ workshops.status }}">{{ workshops.status }}</strong>. <span data-t="{{ workshops.note }}">{{ workshops.note }}</span></p>
{% for e in workshops.episodes %}<div class="card" style="margin-bottom:16px;"><h3><span data-t="Episode {{ e.n }}">Episode {{ e.n }}</span> · <span data-t="{{ e.title }}">{{ e.title }}</span></h3><p class="plain" data-t="Status: proposed">Status: proposed</p></div>{% endfor %}
